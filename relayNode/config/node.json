{
  "hubUrl": "wss://relay.example.com/ws/node",
  "token": "${RELAY_TOKEN}",
  "nodeId": "synlove-home-business",
  "name": "家庭后台功能",
  "heartbeatSeconds": 10,
  "logFile": "logs/businessNode.log",
  "capabilities": [
    {
      "name": "crawlerCenter",
      "priority": 10,
      "concurrency": 4
    },
    {
      "name": "webCollection",
      "priority": 10,
      "concurrency": 4
    },
    {
      "name": "scheduler",
      "priority": 10,
      "concurrency": 4
    },
    {
      "name": "video",
      "priority": 10,
      "concurrency": 4
    }
  ],
  "workers": {
    "crawlerCenter": {
      "mode": "synlove-business",
      "baseUrl": "http://127.0.0.1:8792",
      "apiKeyEnv": "SYNLOVE_BUSINESS_API_KEY",
      "timeoutMs": 1200000
    },
    "webCollection": {
      "mode": "synlove-business",
      "baseUrl": "http://127.0.0.1:8796",
      "apiKeyEnv": "SYNLOVE_BUSINESS_API_KEY",
      "timeoutMs": 1200000
    },
    "scheduler": {
      "mode": "synlove-business",
      "baseUrl": "http://127.0.0.1:8791",
      "apiKeyEnv": "SYNLOVE_BUSINESS_API_KEY",
      "timeoutMs": 1200000
    },
    "video": {
      "mode": "synlove-business",
      "baseUrl": "http://127.0.0.1:8793",
      "apiKeyEnv": "SYNLOVE_BUSINESS_API_KEY",
      "timeoutMs": 1200000
    }
  }
}