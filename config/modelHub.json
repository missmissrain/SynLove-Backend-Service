{
  "version": 1,
  "service": {
    "host": "127.0.0.1",
    "port": 8810,
    "protocol": 1,
    "keepAliveSeconds": 600,
    "defaultLeaseSeconds": 1800,
    "说明": "ModelHub只管理模型驻留与显存，不改变原服务端口和业务API。"
  },
  "models": [
    {
      "name": "llm-gemma",
      "displayName": "Gemma 本地大模型",
      "service": "llm",
      "enabled": true,
      "gpuManaged": true,
      "releasePriority": 10,
      "healthUrl": "http://127.0.0.1:8080/health",
      "unloadUrl": "http://127.0.0.1:8080/internal/gpu/unload",
      "tokenEnv": "SYNLOVE_LLM_API_KEY",
      "estimatedVramMiB": 5000,
      "weightPaths": [
        "../personal-agent/gemma/model/*.gguf",
        "../personal-agent/gemma/model/*.safetensors"
      ]
    },
    {
      "name": "tts-breeze",
      "displayName": "Breeze TTS",
      "service": "tts",
      "enabled": true,
      "gpuManaged": true,
      "releasePriority": 20,
      "healthUrl": "http://127.0.0.1:7862/health",
      "unloadUrl": "http://127.0.0.1:7862/internal/gpu/unload",
      "tokenEnv": "SYNLOVE_TTS_API_KEY",
      "estimatedVramMiB": 4200,
      "weightPaths": [
        "../personal-agent/models/breezeTts2-int8/*.safetensors",
        "../personal-agent/models/breezeTts2/*.safetensors"
      ]
    },
    {
      "name": "asr-whisper",
      "displayName": "Whisper ASR",
      "service": "asr",
      "enabled": true,
      "gpuManaged": false,
      "releasePriority": 40,
      "healthUrl": "http://127.0.0.1:8081/health",
      "estimatedVramMiB": 0,
      "weightPaths": [
        "${USERPROFILE}/.cache/huggingface/hub/models--Systran--faster-whisper-small/blobs/*"
      ]
    },
    {
      "name": "audio-ace-step",
      "displayName": "ACE-Step 音频生成",
      "service": "audio-generation",
      "enabled": true,
      "gpuManaged": false,
      "releasePriority": 50,
      "healthUrl": "http://127.0.0.1:18777/health",
      "estimatedVramMiB": 0,
      "weightPaths": [
        "../aceStepXlBase/checkpoints/acestep-v15-base/*.safetensors",
        "../aceStepXlBase/checkpoints/acestep-5Hz-lm-1.7B/*.safetensors"
      ],
      "说明": "当前生产参数为CPU和offload；切换到GPU前必须把gpuManaged改为true并补充卸载接口。"
    },
    {
      "name": "audio-moss",
      "displayName": "MOSS 音效模型",
      "service": "audio-effects",
      "enabled": true,
      "gpuManaged": true,
      "releasePriority": 30,
      "healthUrl": "http://127.0.0.1:18765/health",
      "estimatedVramMiB": 4500,
      "weightPaths": [
        "../mossSoundEffect/models/*.gguf"
      ],
      "说明": "登记了真实权重，但当前生产端口未确认在线；服务不上线时只显示weightsReady，不显示serviceOnline。"
    },
    {
      "name": "embedding-qwen3",
      "displayName": "Qwen3 Embedding",
      "service": "embedding",
      "enabled": true,
      "gpuManaged": false,
      "releasePriority": 60,
      "estimatedVramMiB": 0,
      "weightPaths": [
        "../aceStepXlBase/checkpoints/Qwen3-Embedding-0.6B/*.safetensors"
      ]
    }
  ],
  "cloud": {
    "enabled": true,
    "timeoutSeconds": 900,
    "usageRetentionDays": 30,
    "providers": {
      "dahuangf": {
        "baseURL": "https://tokens.dahuangf.com/v1",
        "api": "responses"
      },
      "qwen": {
        "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "api": "chat"
      },
      "workbuddy": {
        "baseURL": "http://127.0.0.1:3425/v1",
        "api": "chat"
      }
    }
  }
}