      "status": "available",
      "port": 7862,
      "baseUrl": "http://127.0.0.1:7862",
      "protocol": "OpenAI-audio-compatible",
      "authEnv": "SYNLOVE_TTS_API_KEY",
      "routes": ["/health", "/v1/audio/speech", "/audio/speech", "/speak", "/internal/gpu/unload"],
      "notes": "支持 instruction 音色提示、refAudioBase64 声音克隆、refText、seed 和 wav 输出。"
    },
    {
      "name": "asr-whisper",
