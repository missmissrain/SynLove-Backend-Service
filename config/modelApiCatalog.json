{
  "version": 1,
  "说明": "SynLove 后台模型和业务 API 清单；不包含任何密钥、IP 或用户数据。",
  "models": [
    {
      "name": "llm-gemma",
      "displayName": "Gemma 本地大模型",
      "status": "available",
      "port": 8080,
      "baseUrl": "http://127.0.0.1:8080",
      "protocol": "OpenAI-compatible",
      "authEnv": "SYNLOVE_LLM_API_KEY",
      "routes": ["/health", "/v1/models", "/v1/chat/completions", "/v1/completions", "/v1/embeddings", "/internal/gpu/status", "/internal/gpu/unload"],
